  "workflows": [
    {
      "id": "wf_5svtfgwq",
      "version": 1,
      "tenantId": "tenant_8seup31w",
      "name": "E-Commerce Order Processing & Saga Compensation",
      "description": "Mission-critical distributed transaction executing Payment Capture, Warehouse Inventory Reservation, and Carrier Dispatch with automatic backward Saga rollback upon downstream failure.",
      "status": "ACTIVE",
      "createdBy": "admin@acme.com",
      "nodes": [
        {
          "id": "node-start",
          "type": "START",
          "position": {
            "x": 80,
            "y": 160
          },
          "data": {
            "label": "Receive Order Event",
            "description": "Triggers on incoming customer order event with cart payload"
          }
        },
        {
          "id": "node-payment",
          "type": "HTTP_REQUEST",
          "position": {
            "x": 340,
            "y": 160
          },
          "data": {
            "label": "Authorize & Capture Payment",
            "description": "Charges customer payment method via Stripe/Adyen API",
            "method": "POST",
            "url": "https://api.example.com/v1/payments/capture",
            "body": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": \"{{amount}}\",\n  \"currency\": \"USD\"\n}",
            "timeoutMs": 5000,
            "retryPolicy": {
              "maxAttempts": 2,
              "initialDelayMs": 1000,
              "backoffMultiplier": 2,
              "retryOnStatuses": [
                500,
                502,
                503
              ]
            },
            "compensation": {
              "enabled": true,
              "name": "Refund Payment Transaction",
              "method": "POST",
              "url": "https://api.example.com/v1/payments/refund",
              "simulatedAction": "Refund $249.99 to customer credit card via payment gateway"
            }
          }
        },
        {
          "id": "node-inventory",
          "type": "HTTP_REQUEST",
          "position": {
            "x": 620,
            "y": 160
          },
          "data": {
            "label": "Reserve Warehouse Inventory",
            "description": "Locks physical SKU units in inventory management system",
            "method": "POST",
            "url": "https://api.example.com/v1/inventory/reserve",
            "body": "{\n  \"sku\": \"SKU-QUANTUM-X\",\n  \"quantity\": 1\n}",
            "timeoutMs": 5000,
            "retryPolicy": {
              "maxAttempts": 3,
              "initialDelayMs": 1000,
              "backoffMultiplier": 2
            },
            "compensation": {
              "enabled": true,
              "name": "Release Reserved Inventory",
              "method": "POST",
              "url": "https://api.example.com/v1/inventory/release",
              "simulatedAction": "Released 1 unit of SKU-QUANTUM-X back to active inventory pool"
            }
          }
        },
        {
          "id": "node-condition",
          "type": "CONDITION",
          "position": {
            "x": 900,
            "y": 160
          },
          "data": {
            "label": "Evaluate Inventory Status",
            "description": "Checks if warehouse response confirmed physical stock availability",
            "conditionField": "status",
            "conditionOperator": "==",
            "conditionValue": "200"
          }
        },
        {
          "id": "node-shipment",
          "type": "HTTP_REQUEST",
          "position": {
            "x": 1180,
            "y": 100
          },
          "data": {
            "label": "Create Carrier Shipment & Waybill",
            "description": "Dispatches parcel via FedEx/DHL logistics API",
            "method": "POST",
            "url": "https://api.example.com/v1/logistics/shipments",
            "body": "{\n  \"service\": \"PRIORITY_OVERNIGHT\",\n  \"weightKg\": 1.2\n}",
            "timeoutMs": 5000,
            "retryPolicy": {
              "maxAttempts": 3,
              "initialDelayMs": 1000,
              "backoffMultiplier": 2,
              "retryOnStatuses": [
                500,
                502,
                503,
                504
              ]
            },
            "compensation": {
              "enabled": true,
              "name": "Void Carrier Shipping Label",
              "method": "DELETE",
              "url": "https://api.example.com/v1/logistics/shipments/cancel",
              "simulatedAction": "Voided carrier shipping label and cancelled pickup dispatch"
            },
            "simulateFailure": false
          }
        },
        {
          "id": "node-transform",
          "type": "TRANSFORM",
          "position": {
            "x": 1450,
            "y": 100
          },
          "data": {
            "label": "Generate Order Invoice & Telemetry",
            "description": "Calculates tax, discounts and formats executive summary in VM sandbox",
            "transformScript": "// Safe sandboxed calculation\nconst subtotal = input.amount || 249.99;\nconst taxRate = 0.0825;\nconst tax = Math.round(subtotal * taxRate * 100) / 100;\nconst total = Math.round((subtotal + tax) * 100) / 100;\n\nreturn {\n  invoiceId: \"INV-\" + Math.floor(100000 + Math.random() * 900000),\n  subtotal: subtotal,\n  tax: tax,\n  totalCharged: total,\n  fulfillmentCenter: \"FC-AUSTIN-04\",\n  generatedAt: new Date().toISOString()\n};"
          }
        },
        {
          "id": "node-log-fallback",
          "type": "LOG",
          "position": {
            "x": 1180,
            "y": 300
          },
          "data": {
            "label": "Log Out-of-Stock Alert",
            "description": "Publishes notification when inventory check fails",
            "logMessage": "Order entered backorder state: warehouse allocation unsuccessful",
            "logLevel": "WARN"
          }
        },
        {
          "id": "node-end",
          "type": "END",
          "position": {
            "x": 1720,
            "y": 160
          },
          "data": {
            "label": "Order Processing Complete",
            "description": "Workflow execution succeeded and customer transaction closed"
          }
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "node-start",
          "target": "node-payment"
        },
        {
          "id": "e2",
          "source": "node-payment",
          "target": "node-inventory"
        },
        {
          "id": "e3",
          "source": "node-inventory",
          "target": "node-condition"
        },
        {
          "id": "e4",
          "source": "node-condition",
          "target": "node-shipment",
          "sourceHandle": "true",
          "label": "In Stock (True)"
        },
        {
          "id": "e5",
          "source": "node-condition",
          "target": "node-log-fallback",
          "sourceHandle": "false",
          "label": "Out of Stock (False)"
        },
        {
          "id": "e6",
          "source": "node-shipment",
          "target": "node-transform"
        },
        {
          "id": "e7",
          "source": "node-transform",
          "target": "node-end"
        },
        {
          "id": "e8",
          "source": "node-log-fallback",
          "target": "node-end"
        }
      ],
      "createdAt": "2026-10-08T15:27:09.903Z",
      "updatedAt": "2026-10-08T15:27:09.903Z"
    }
  ],
